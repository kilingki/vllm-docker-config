# Internal bind and controller limits. Model profiles must not set HOST or PORT.
VLLM_BIN=vllm
LOAD_TIMEOUT_SEC=600
UNLOAD_TIMEOUT_SEC=30
KILL_GRACE_SEC=5
HOST=127.0.0.1
PORT=8080
MAX_ACTIVE_REQUESTS=4
MAX_BODY_BYTES=33554432
MAX_OUTPUT_TOKENS=4096
REQUIRE_EXPLICIT_OUTPUT_LIMIT=1
HEALTH_PROBE_INTERVAL_SEC=5
HEALTH_PROBE_TIMEOUT_SEC=10
HEALTH_PROBE_FAILURES=3
STREAM_BUFFER_MAX_BYTES=4194304
ALLOWLIST_PATH=configs/vllm_cli_allowlist.json
