# Qwen3.8-27B VLM target profile. Paths are inside the container.
# Quantization is not forced here; loader selection follows checkpoint metadata.
# Do not set HOST or PORT in this file.
MODEL_PATH=/models/qwen3.8-27b
SERVED_MODEL_NAME=qwen3.8-27b
DTYPE=bfloat16
TENSOR_PARALLEL_SIZE=1
MAX_MODEL_LEN=32768
MAX_NUM_SEQS=4
MAX_NUM_BATCHED_TOKENS=2048
GPU_MEMORY_UTILIZATION=0.90
KV_CACHE_DTYPE=fp8_e4m3
PREFIX_CACHING=on
REASONING_PARSER=qwen3
LIMIT_MM_IMAGE=4
MM_PROCESSOR_KWARGS={"max_pixels":262144}
EXTRA_ARGV_JSON=[]
